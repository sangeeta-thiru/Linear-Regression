# -------------------------------
# People Spending → Savings Prediction
# Linear Regression vs Random Forest
# -------------------------------

# Import required libraries
import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt

# -------------------------------
# Step 1: Load Dataset
# -------------------------------
df = pd.read_csv(r"C:\Users\AT Sangeeta\OneDrive\Desktop\tp\Machine learning\people_spending.csv")
print("Dataset shape:", df.shape)
print("\nMissing values:\n", df.isnull().sum())
print("\nDescriptive Statistics:\n", df.describe())

# Preview first few rows
df.head()

# -------------------------------
# Step 2: Visualize Relationship (Age vs Savings)
# -------------------------------
plt.figure(figsize=(6,4))
plt.title("Age vs Savings")
sns.scatterplot(x="Age", y="Savings", data=df)
sns.regplot(x="Age", y="Savings", data=df, ci=None, color="red")
plt.show()

# -------------------------------
# Step 3: Simple Linear Regression (Age → Savings)
# -------------------------------
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score

X = df["Age"].values.reshape(-1,1)
y = df["Savings"]

x_train, x_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)

lr_model = LinearRegression().fit(x_train, y_train)

# Predictions
y_train_pred = lr_model.predict(x_train)
y_test_pred = lr_model.predict(x_test)

print("\n--- Simple Linear Regression ---")
print(f"Train R2: {round(r2_score(y_train, y_train_pred),3)}")
print(f"Test  R2: {round(r2_score(y_test, y_test_pred),3)}")

# -------------------------------
# Step 4: Multiple Linear Regression (Age + Spending_Food + Spending_Travel)
# -------------------------------
X = df[["Age", "Spending_Food", "Spending_Travel"]]
y = df["Savings"]

x_train, x_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)

mlr_model = LinearRegression().fit(x_train, y_train)

y_train_pred = mlr_model.predict(x_train)
y_test_pred = mlr_model.predict(x_test)

print("\n--- Multiple Linear Regression ---")
print(f"Train R2: {round(r2_score(y_train, y_train_pred),3)}")
print(f"Test  R2: {round(r2_score(y_test, y_test_pred),3)}")

# -------------------------------
# Step 5: Adding Occupation Feature (Categorical → One-Hot Encoding)
# -------------------------------
occupations = ["doctor", "teacher", "cleaner"]
df["occupation"] = np.random.choice(occupations, size=len(df))  # Random assignment

# Convert categorical to numerical
X = pd.get_dummies(df[["Age","Spending_Food","Spending_Travel","occupation"]])
y = df["Savings"]

x_train, x_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)

mlr_model = LinearRegression().fit(x_train, y_train)

y_train_pred = mlr_model.predict(x_train)
y_test_pred = mlr_model.predict(x_test)

print("\n--- Multiple Linear Regression with Occupation ---")
print(f"Train R2: {round(r2_score(y_train, y_train_pred),3)}")
print(f"Test  R2: {round(r2_score(y_test, y_test_pred),3)}")

# -------------------------------
# Step 6: Decision Tree Regressor (Non-Linear Model)
# -------------------------------
from sklearn.tree import DecisionTreeRegressor

tree_model = DecisionTreeRegressor(max_depth=5, min_samples_split=4, min_samples_leaf=2, random_state=42)
tree_model.fit(x_train, y_train)

tree_y_train_pred = tree_model.predict(x_train)
tree_y_test_pred = tree_model.predict(x_test)

print("\n--- Decision Tree Regressor ---")
print(f"Train R2: {round(r2_score(y_train, tree_y_train_pred),3)}")
print(f"Test  R2: {round(r2_score(y_test, tree_y_test_pred),3)}")

# -------------------------------
# Step 7: Visualization (Original vs Predicted)
# -------------------------------
plt.figure(figsize=(12,5))

# Original Data
plt.subplot(1,2,1)
plt.title("Original Data (Age vs Savings)")
sns.scatterplot(x="Age", y="Savings", data=df)
sns.regplot(x="Age", y="Savings", data=df, ci=None, color="red")

# Predicted vs Actual (Decision Tree)
plt.subplot(1,2,2)
plt.title("Decision Tree Predictions")
plt.scatter(y_test, tree_y_test_pred, color="blue")
plt.xlabel("Actual Savings")
plt.ylabel("Predicted Savings")
plt.axhline(0, color="red")
plt.tight_layout()
plt.show()

# -------------------------------
# Step 8: Final Note on Model Performance
# -------------------------------
print("""
Observations:
- Linear Regression (simple & multiple) → weak R² (poor fit).
- Adding Occupation did not improve much because it was random noise.
- Decision Tree achieved high training accuracy (overfitting) but poor test accuracy.
- Dataset is too small (50 samples). Need more meaningful features & larger dataset.
- To fix this,we can add better features or change the model
""")


