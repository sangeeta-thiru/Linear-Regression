from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score

# building the LR model and doing predictions
x=df["Age"]
y=df["Savings"]
x_train,x_test,y_train,y_test=train_test_split(x,y,test_size=0.3,random_state=42)
x_train=x_train.values.reshape(-1,1)
x_test=x_test.values.reshape(-1,1)
model=LinearRegression().fit(x_train,y_train)
ytrain_pred=model.predict(x_train)
ytrain_pred_score=r2_score(y_train,ytrain_pred)
ytest_pred=model.predict(x_test)
ytest_pred_score=r2_score(y_test,ytest_pred)
print(f"y_train_pred_score: {round(ytrain_pred_score,3)}\ny_test_pred_score: {round(ytest_pred_score,3)}")
# we see r2 scores are not nearing to 1, so we are going to do multiple LR model

# since r2 scores are not good, Iam going for multiple linear regression taking columns like 
# "Age","Spending_Food","Spending_Travel"

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score
# building the multiple LR model and doing predictions
x=df[["Age","Spending_Food","Spending_Travel"]]
y=df["Savings"]
x_train,x_test,y_train,y_test=train_test_split(x,y,test_size=0.3,random_state=42)
model=LinearRegression().fit(x_train,y_train)
ytrain_pred=model.predict(x_train)
ytrain_pred_score=r2_score(y_train,ytrain_pred)
ytest_pred=model.predict(x_test)
ytest_pred_score=r2_score(y_test,ytest_pred)
print(f"y_train_pred_score: {round(ytrain_pred_score,3)}\ny_test_pred_score: {round(ytest_pred_score,3)}")

# again r2 scores are not good, Iam going add a column called "occupation"
# so people savings can be explained by their job
occu=["doctor","teacher","cleaner"]
df["occupation"]=np.random.choice(occu,size=len(df))
df["occupation"]
df.head()


# converting occupation column into numerical values 
x=pd.get_dummies(df[["Age","Spending_Food","Spending_Travel","occupation"]])

# building and doing predictions with new data
x=pd.get_dummies(df[["Age","Spending_Food","Spending_Travel","occupation"]])
y=df["Savings"]
x_train1,x_test1,y_train1,y_test1=train_test_split(x,y,test_size=0.3,random_state=42)
model=LinearRegression().fit(x_train1,y_train1)
ytrain_pred1=model.predict(x_train1)
ytest_pred1=model.predict(x_test1)
print(f"y_train_pred_score: {round(r2_score(y_train1,ytrain_pred1),3)}\ny_test_pred_score: {round(r2_score(y_test1,ytest_pred1),3)}")

# As multiple LR model also failed , I bulit Random Forest regressor model which was good model
# building Random forest regressor model
from sklearn.tree import DecisionTreeRegressor
tree_model=DecisionTreeRegressor(max_depth=5,min_samples_split=4,min_samples_leaf=2,random_state=42)
tree_model.fit(x_train1,y_train1)
tree_ytrain_pred=tree_model.predict(x_train1)
tree_ytest_pred=tree_model.predict(x_test1)
print(f"y_train_pred_score: {round(r2_score(y_train1,tree_ytrain_pred),3)}\ny_test_pred_score: {round(r2_score(y_test1,tree_ytest_pred),3)}")

plt.figure(figsize=(15,5))
